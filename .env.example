# ---------------------------------------------------------------
# Sea Sentry AI — production environment template
# Copy to .env locally; set these as Railway service variables in production.
# Never commit real values.
# ---------------------------------------------------------------

# Required: PostgreSQL (Railway reference variable, not a browser variable)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Required: single-operator console access
# Set one of these two. Prefer a scrypt hash generated offline.
OPERATOR_PASSWORD=replace-with-a-long-unique-operator-password
# OPERATOR_PASSWORD_HASH=scrypt$SALT$DIGEST
SESSION_SECRET=replace-with-at-least-32-random-characters

# Required for links in notifications / phone callbacks / Web Push
PUBLIC_BASE_URL=https://your-production-domain.example
NEXT_PUBLIC_APP_URL=https://your-production-domain.example

# Optional: Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:operator@your-domain.example

# Optional: Telegram Bot API (server-side only)
TELEGRAM_BOT_TOKEN=
# TELEGRAM_API_BASE=https://api.telegram.org

# Optional: Twilio Programmable Voice (server-side only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15550000000
# Secret appended to Twilio status callbacks
TWILIO_STATUS_SECRET=
# TWILIO_API_BASE=https://api.twilio.com

# Platform-provided at runtime; do not hardcode in source
# PORT=3000
# NODE_ENV=production
